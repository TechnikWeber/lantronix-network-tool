<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:LantronixTool"
        x:Class="LantronixTool.MainWindow"
        Title="Lantronix Network Tool"
        Icon="/Assets/icon.png"
        Width="860" Height="560" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">

    <!-- search bar -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
      <Button x:Name="SearchButton" Classes="accent" MinWidth="110" HorizontalContentAlignment="Center"
              Content="{x:Static l:T.Search}" IsDefault="True" Click="OnSearch" />
      <Button x:Name="CancelButton" Grid.Column="1" Content="{x:Static l:T.Cancel}" IsEnabled="False"
              Click="OnCancel" />
      <TextBox x:Name="FilterBox" Grid.Column="2" PlaceholderText="{x:Static l:T.MacFilter}"
               ToolTip.Tip="{x:Static l:T.MacFilterTip}" />
      <ComboBox x:Name="DurationBox" Grid.Column="3" SelectedIndex="0" MinWidth="150">
        <ComboBoxItem Content="{x:Static l:T.Quick}" />
        <ComboBoxItem Content="{x:Static l:T.Thorough}" />
        <ComboBoxItem Content="{x:Static l:T.Long}" />
      </ComboBox>
    </Grid>

    <Expander DockPanel.Dock="Top" Margin="0,8,0,0" HorizontalAlignment="Stretch"
              Header="{x:Static l:T.More}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBox x:Name="TargetsBox" PlaceholderText="{x:Static l:T.TargetsHint}"
                 ToolTip.Tip="{x:Static l:T.TargetsTip}" />
        <CheckBox x:Name="BroadcastBox" Grid.Column="1" IsChecked="True" Content="{x:Static l:T.Broadcast}" />
      </Grid>
    </Expander>

    <!-- status line -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,10,0,0">
      <SelectableTextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
      <ProgressBar x:Name="Busy" Grid.Column="1" IsIndeterminate="True" IsVisible="False" Width="140"
                   VerticalAlignment="Center" />
    </Grid>

    <!-- actions -->
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" ItemSpacing="8" LineSpacing="8">
      <Button x:Name="OpenButton" Content="{x:Static l:T.OpenWeb}" IsEnabled="False" Click="OnOpenWeb" />
      <Button Content="{x:Static l:T.AssignIp}" Click="OnAssign" />
      <Button x:Name="CopyButton" Content="{x:Static l:T.CopyAll}" IsEnabled="False" Click="OnCopyAll" />
      <Button x:Name="CsvButton" Content="{x:Static l:T.SaveCsv}" IsEnabled="False" Click="OnSaveCsv" />
    </WrapPanel>

    <!-- device list -->
    <Border Margin="0,12,0,0" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
            BorderBrush="{DynamicResource CardBorderBrush}"
            Background="{DynamicResource CardBrush}">
      <Grid RowDefinitions="Auto,*">
        <Border Padding="12,8" BorderThickness="0,0,0,1" Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}">
          <Grid ColumnDefinitions="150,180,*">
            <TextBlock Classes="hint" FontWeight="SemiBold" Text="{x:Static l:T.ColIp}" />
            <TextBlock Classes="hint" FontWeight="SemiBold" Grid.Column="1" Text="{x:Static l:T.ColMac}" />
            <TextBlock Classes="hint" FontWeight="SemiBold" Grid.Column="2" Text="{x:Static l:T.ColNet}" />
          </Grid>
        </Border>
        <ListBox x:Name="List" Grid.Row="1" Background="Transparent" SelectionMode="Single"
                 SelectionChanged="OnSelectionChanged" DoubleTapped="OnDoubleTapped">
          <ListBox.ContextMenu>
            <ContextMenu x:Name="RowMenu">
              <MenuItem Header="{x:Static l:T.OpenWeb}" Click="OnOpenWeb" />
              <MenuItem Header="{x:Static l:T.AssignIp}" Click="OnAssign" />
              <Separator />
              <MenuItem Header="{x:Static l:T.CopyIp}" Click="OnCopyIp" />
              <MenuItem Header="{x:Static l:T.CopyMac}" Click="OnCopyMac" />
              <MenuItem Header="{x:Static l:T.CopyTelnet}" Click="OnCopyTelnet" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="l:DeviceRow">
              <Grid ColumnDefinitions="150,180,*">
                <TextBlock Classes="mono" Text="{Binding Ip}" VerticalAlignment="Center" />
                <TextBlock Classes="mono" Grid.Column="1" Text="{Binding Mac}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Network}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Classes.hint="{Binding Unusual}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <SelectableTextBlock x:Name="EmptyText" Grid.Row="1" Margin="24" TextWrapping="Wrap"
                             HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                             Foreground="{DynamicResource HintBrush}" />
      </Grid>
    </Border>
  </DockPanel>
</Window>
