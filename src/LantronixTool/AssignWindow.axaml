<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:LantronixTool"
        x:Class="LantronixTool.AssignWindow"
        Title="{x:Static l:T.AssignTitle}"
        Icon="/Assets/icon.png"
        Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="{x:Static l:T.AssignIntro}" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
      <TextBlock Text="{x:Static l:T.AssignMac}" VerticalAlignment="Center" />
      <TextBox x:Name="MacBox" Grid.Column="1" Classes="mono" PlaceholderText="00-80-A3-…"
               TextChanged="OnTextChanged" />
      <TextBlock Grid.Row="1" Text="{x:Static l:T.AssignIpLabel}" VerticalAlignment="Center" />
      <TextBox x:Name="IpBox" Grid.Row="1" Grid.Column="1" Classes="mono" TextChanged="OnTextChanged" />
      <TextBlock Grid.Row="2" Text="{x:Static l:T.AssignNet}" VerticalAlignment="Center" />
      <ComboBox x:Name="NetBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                SelectionChanged="OnNetChanged" />
    </Grid>
    <Expander Header="{x:Static l:T.AssignCommands}" HorizontalAlignment="Stretch">
      <SelectableTextBlock x:Name="ScriptText" Classes="mono" FontSize="12" TextWrapping="Wrap" />
    </Expander>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <SelectableTextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button x:Name="GoButton" Classes="accent" Content="{x:Static l:T.AssignGo}" IsDefault="True"
                Click="OnGo" IsEnabled="False" />
        <Button x:Name="CloseButton" Content="{x:Static l:T.Close}" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
